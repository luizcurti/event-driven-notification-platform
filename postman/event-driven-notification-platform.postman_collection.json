          "path": ["notifications", "{{notificationId}}"]
        },
        "description": "Cancelling an already-canceled (or already-delivered) notification is rejected."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () {",
